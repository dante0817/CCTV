# CCTV Monitor backend
PORT=3000

# Required for USB DirectShow capture unless ffmpeg.exe is already in PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Optional: MediaMTX binary/config overrides. The default expected binary is tools\mediamtx\mediamtx.exe.
# MEDIAMTX_PATH=C:\path\to\mediamtx.exe
# MEDIAMTX_CONFIG=C:\path\to\mediamtx.yml
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
MEDIAMTX_HLS_URL=http://127.0.0.1:8888

# Optional SQLite location. Default: data\cctv.db
# CCTV_DB_PATH=C:\CCTV\data\cctv.db

# Explicit demo mode only. Keep false for real hardware.
CCTV_DEMO_MODE=false
VITE_CCTV_DEMO_MODE=false

# Optional AI assistant / live voice features.
GEMINI_API_KEY=

# Optional hardening. If unset, a fresh runtime-only media signing key is generated on each start.
# Set a long random value in production to keep media tokens valid across a controlled app restart.
# CCTV_MEDIA_TOKEN_SECRET=replace-with-a-long-random-secret

# Set true only after HTTPS is deliberately configured for the entire app/media origin.
CCTV_COOKIE_SECURE=false

# P0.10 rotating log limits (optional).
CCTV_LOG_MAX_BYTES=2097152
CCTV_LOG_MAX_FILES=5

# Optional RTSP credential encryption key. If unset, CCTV Monitor generates
# data\.credential-key on first start. Back up that file with the database;
# losing it makes stored RTSP passwords unreadable.
# CCTV_CREDENTIAL_KEY=replace-with-a-long-random-secret

# P0.13 continuous USB recording. Finalized MP4 segments are stored under
# CCTV_RECORDINGS_DIR (default: data\recordings). Smaller segments appear
# sooner in playback but create more files. Supported range: 30–3600 seconds.
CCTV_RECORDING_SEGMENT_SECONDS=60
# CCTV_RECORDINGS_DIR=X:\CCTV-Recordings

# P0.14.1 motion snapshots. Default: data\snapshots.
# Snapshots are served only through authenticated event routes; this directory is not static web content.
# CCTV_SNAPSHOTS_DIR=X:\CCTV-Snapshots
